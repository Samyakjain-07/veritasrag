# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Env / secrets
.env
.env.*
!.env.example
keys/

# Trained model artifacts
models/

# Signed deletion receipts (Phase 6 unlearning audit trail)
receipts/

# OTel JSONL trace file (Phase 7 observability). Leading slash matters here,
# unlike the generated dirs above: a bare "observability/" is unanchored (git
# matches it at any depth) and would also match the tracked src/observability/
# package, silently ignoring any new file that ever lands there.
/observability/

# LLM-judge dev cache
eval/benchmarks/.judge_cache.json

# Test / lint / type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Qdrant local storage
qdrant_storage/

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/
*:Zone.Identifier

# Claude Code local tooling state (permission allowlist, scheduled-task
# locks) -- machine-local, same category as .idea//.vscode/ above. Not
# previously listed here (an oversight, not deliberate); CLAUDE.md itself is
# a real tracked project file and is unaffected by this pattern.
.claude/

# Logs
*.log
