# Copy this file to .env and fill in real values. .env is gitignored; this file is not.

# Generation (Phase 5+) -- LLM_PROVIDER selects which key/model is active.
# "openai" (default) uses OPENAI_API_KEY; "anthropic" uses ANTHROPIC_API_KEY.
# See src/generation/llm_client.py. Existing Claude-specific code is untouched
# by this switch -- it's just no longer the hardcoded default.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-5.4
ANTHROPIC_API_KEY=
ANTHROPIC_GENERATION_MODEL=claude-sonnet-5
# Note: OPENAI_API_KEY above is also used by Phase 3's LLM-judge baseline
# (src/detection/llm_judge.py) regardless of LLM_PROVIDER.

# Hugging Face (dataset / model downloads)
HF_TOKEN=

# Qdrant vector store (Phase 2)
QDRANT_URL=http://localhost:6333

# Embeddings (Phase 2)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Provenance signing key directory (Phase 2)
PROVENANCE_KEY_DIR=keys

# Poison detection (Phase 3)
PERPLEXITY_MODEL_NAME=distilgpt2
OPENAI_JUDGE_MODEL=gpt-5.4-mini
# See src/detection/config.py for the full list of overridable detection
# thresholds/weights (CLUSTER_KNN_K, CLASSIFIER_SEED, POISON_SCORE_THRESHOLD, ...).
