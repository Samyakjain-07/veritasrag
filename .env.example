# Copy this file to .env and fill in real values. .env is gitignored; this file is not.

# Generation (Phase 5+) -- LLM_PROVIDER selects which key/model is active.
# "openai" (default) uses OPENAI_API_KEY; "anthropic" uses ANTHROPIC_API_KEY.
# See src/generation/llm_client.py. Existing Claude-specific code is untouched
# by this switch -- it's just no longer the hardcoded default.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-5.4
ANTHROPIC_API_KEY=
ANTHROPIC_GENERATION_MODEL=claude-sonnet-5
# Note: OPENAI_API_KEY above is also used by Phase 3's LLM-judge baseline
# (src/detection/llm_judge.py) regardless of LLM_PROVIDER.

# Hugging Face (dataset / model downloads)
HF_TOKEN=

# Qdrant vector store (Phase 2)
QDRANT_URL=http://localhost:6333

# Embeddings (Phase 2)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Provenance signing key directory (Phase 2)
PROVENANCE_KEY_DIR=keys

# Poison detection (Phase 3)
PERPLEXITY_MODEL_NAME=distilgpt2
OPENAI_JUDGE_MODEL=gpt-5.4-mini
# See src/detection/config.py for the full list of overridable detection
# thresholds/weights (CLUSTER_KNN_K, CLASSIFIER_SEED, POISON_SCORE_THRESHOLD, ...).

# Retrieval policy (Phase 4)
RETRIEVAL_TOP_K=5
POLICY_ALLOW_QUARANTINED_TIER=false
# See src/retrieval/config.py for the full list of overridable retrieval
# thresholds (POLICY_POISON_DOWNWEIGHT_VERIFIED, POLICY_POISON_HARDDROP_UNVERIFIED,
# FREQUENCY_ZSCORE_THRESHOLD, EXIT_CRITERIA_ASR_REDUCTION_PP_MIN, ...).

# Generation + faithfulness (Phase 5)
GENERATION_MAX_CONTEXT_CHUNKS=5
GENERATION_TEMPERATURE=0.0
FAITHFULNESS_NLI_MODEL_NAME=cross-encoder/nli-deberta-v3-xsmall
FAITHFULNESS_ENTAILMENT_THRESHOLD=0.5
# See src/generation/config.py for the full list of overridable generation/
# faithfulness knobs (GENERATION_MAX_CHARS_PER_CHUNK, GENERATION_SYSTEM_PROMPT,
# FAITHFULNESS_MIN_CLAIM_CHARS, ...).

# Verifiable unlearning (Phase 6)
UNLEARNING_RECEIPT_DIR=receipts
RECONSTRUCTION_CHANCE_PERCENTILE=95.0
# See src/unlearning/config.py for the full list of overridable unlearning
# knobs (UNLEARNING_COMPACTION_DELETED_THRESHOLD, GHOST_DEFENSE_SEARCH_K,
# RECONSTRUCTION_CHANCE_SAMPLE_SIZE, UNLEARNING_EVAL_SAMPLE_SIZE, ...).

# Observability (Phase 7) -- no external trace backend (no Jaeger/Tempo/OTel
# collector) exists in this project's infra; spans are appended as JSON
# lines to OTEL_TRACE_FILE_PATH, which dashboard/app.py reads directly.
OTEL_SERVICE_NAME=veritasrag
OTEL_TRACE_FILE_PATH=observability/traces.jsonl
OTEL_SPAN_PROCESSOR=simple
OTEL_CONSOLE_EXPORT=false
# See src/observability/config.py for the full list of overridable knobs.
